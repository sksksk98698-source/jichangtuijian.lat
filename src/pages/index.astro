---
import ContentCard from '../components/ContentCard.astro';
import HeroHeader from '../components/HeroHeader.astro';
import PageShell from '../layouts/PageShell.astro';
import PostListItem from '../components/PostListItem.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { heroConfig, locale, siteDescription, siteTitle } from '../config';
import { getBlogPosts } from '../lib/content/blog';
import { brandsList } from '../data/brands';

const posts = await getBlogPosts();
const siteURL = Astro.site ?? Astro.url;
const postCount = posts.length;
const wordCount = posts.reduce((acc, post) => acc + (post.body ? post.body.length : 0), 0);
const tagCount = new Set(posts.flatMap((post) => post.data.tags || [])).size;
const recentPosts = posts.slice(0, 10);
const hasPosts = postCount > 0;
const homeHero = heroConfig.home;

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', siteURL).toString(),
  url: new URL('/', siteURL).toString(),
  name: siteTitle,
  description: siteDescription,
  inLanguage: locale,
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', siteURL).toString(),
  name: siteTitle,
  url: new URL('/', siteURL).toString(),
  logo: new URL('/favicon.svg', siteURL).toString(),
  description: siteDescription,
};

function formatWordCount(count: number) {
  if (count > 10000) {
    return `${(count / 10000).toFixed(2)} 万`;
  }
  return count.toString();
}
---

<PageShell
  title={siteTitle}
  description={siteDescription}
  schema={[webSiteSchema, organizationSchema]}
  transparentHeader={true}
  pageId="home"
>
  <style>
      .stats-wrapper {
        position: relative;
        background-color: var(--color-bg);
        min-height: 50vh;
      }

      .stats-container {
        background: var(--color-surface);
        border-radius: 16px;
        box-shadow: var(--shadow-card);
        padding: 2.2em;
        display: flex;
        flex-direction: column;
        gap: 3.5em;
      }

      /* Featured Top 10 Grid */
      .top-ten-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.4em;
        margin-top: 1.2em;
      }

      .top-brand-card {
        position: relative;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 1.5em;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .top-brand-card:hover {
        transform: translateY(-3px);
        border-color: var(--accent);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
      }

      .top-brand-card.is-king {
        border: 2px solid var(--accent);
        background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 6%, var(--color-surface)) 0%, var(--color-surface) 100%);
      }

      .king-ribbon {
        position: absolute;
        top: 10px;
        right: 12px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        font-size: 0.75em;
        font-weight: 700;
        padding: 0.2em 0.7em;
        border-radius: 999px;
      }

      .card-header-line {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.5em;
      }

      .brand-title-group {
        display: flex;
        align-items: baseline;
        gap: 0.5em;
      }

      .rank-tag {
        font-weight: 800;
        color: var(--accent);
        font-size: 1.1em;
      }

      .b-name {
        margin: 0;
        font-size: 1.25em;
        font-weight: 700;
        color: var(--color-text);
      }

      .b-price {
        font-weight: 700;
        color: #e11d48;
        font-size: 0.95em;
      }

      .b-tag-pill {
        display: inline-block;
        align-self: flex-start;
        padding: 0.2em 0.6em;
        border-radius: 6px;
        background: color-mix(in srgb, var(--accent) 12%, transparent);
        color: var(--accent);
        font-size: 0.8em;
        font-weight: 600;
        margin-bottom: 0.7em;
      }

      .b-summary {
        font-size: 0.9em;
        line-height: 1.55;
        color: var(--color-text-secondary);
        margin: 0 0 1.2em 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .b-card-footer {
        margin-top: auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.7em;
      }

      .btn-b-review,
      .btn-b-aff {
        padding: 0.6em 0.4em;
        font-size: 0.85em;
        font-weight: 600;
        text-align: center;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .btn-b-review {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        color: var(--color-text);
      }

      .btn-b-review:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      .btn-b-aff {
        background: var(--accent);
        border: 1px solid var(--accent);
        color: #fff;
      }

      .btn-b-aff:hover {
        background: var(--accent-dark);
      }

      /* Quick Hub Banner */
      .hub-banner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5em;
      }

      .hub-card {
        padding: 1.8em;
        border-radius: 16px;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .hub-card h3 {
        margin: 0 0 0.4em 0;
        font-size: 1.3em;
      }

      .hub-card p {
        margin: 0 0 1.2em 0;
        font-size: 0.92em;
        line-height: 1.6;
        color: var(--color-text-secondary);
      }

      .hub-btn {
        align-self: flex-start;
        padding: 0.6em 1.4em;
        border-radius: 999px;
        background: var(--color-surface);
        border: 1px solid var(--color-border-strong);
        color: var(--color-text);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9em;
        transition: all 0.2s ease;
      }

      .hub-btn:hover {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
      }

      /* Stats Grid */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--color-border);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        overflow: hidden;
      }

      .stat-item {
        background: var(--color-surface);
        padding: 1.8em;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      }

      .stat-value {
        font-size: 2em;
        font-weight: 800;
        color: var(--accent);
      }

      .stat-label {
        font-size: 0.88em;
        color: var(--color-text-muted);
        margin-top: 0.4em;
      }

      .home-posts-list :global(.home-post-item) {
        border-bottom: 1px solid var(--color-border-subtle);
        padding: 1.2em 0;
      }

      .home-posts-list :global(.home-post-title a) {
        color: var(--color-text);
        text-decoration: none;
        font-size: 1.15em;
        font-weight: 600;
      }

      .home-posts-list :global(.home-post-title a:hover) {
        color: var(--accent);
      }

      .blog-link {
        display: inline-block;
        padding: 0.65em 1.4em;
        border-radius: 999px;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        color: var(--color-text);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9em;
        margin-top: 1.2em;
        transition: all 0.2s ease;
      }

      .blog-link:hover {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
      }

      @media (max-width: 720px) {
        .hub-banner {
          grid-template-columns: 1fr;
        }

        .stats-grid {
          grid-template-columns: 1fr;
        }

        .stats-container {
          padding: 1.2em;
        }
      }
    </style>

  <HeroHeader
    text={homeHero.text}
    subtitle={homeHero.subtitle}
    backgroundImage={homeHero.backgroundImage}
    interactive={true}
  />

  <div class="stats-wrapper">
    <ContentCard id="stats-card">
      <div class="stats-container">
        <!-- 42 家高速机场全量矩阵 (光速云领衔) -->
        <section class="top-featured-section">
          <SectionHeader
            number="01"
            title="全量矩阵 · 42 家精选高速机场全景评测"
            intro="全量收录 42 家主流加速服务商，综合晚高峰 4K 测速、IEPL/IPLC 专线可用率与流媒体/ChatGPT 真实解锁表现，支持直达官网与万字测评。"
          />

          <div class="top-ten-grid">
            {brandsList.map((brand) => (
              <div class:list={['top-brand-card', { 'is-king': brand.rank === 1 }]}>
                {brand.rank === 1 && <div class="king-ribbon">👑 综合第一主推</div>}

                <div class="card-header-line">
                  <div class="brand-title-group">
                    <span class="rank-tag">#{brand.rank}</span>
                    <h3 class="b-name">{brand.name}</h3>
                  </div>
                  <span class="b-price">{brand.startingPrice}</span>
                </div>

                <div class="b-tag-pill">{brand.tag}</div>

                <p class="b-summary">{brand.summary}</p>

                <div class="b-card-footer">
                  <a href={`/blog/${brand.id}-review/`} class="btn-b-review">
                    详细测评 &rarr;
                  </a>
                  <a
                    href={brand.affUrl}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn-b-aff"
                  >
                    直达官网 🚀
                  </a>
                </div>
              </div>
            ))}
          </div>

          <div style="text-align: center; margin-top: 2.2em;">
            <a href="/airports/" class="blog-link" style="font-weight: 700; padding: 0.85em 2.4em; background: var(--accent); color: #fff; border-color: var(--accent); border-radius: 999px; text-decoration: none; display: inline-block;">
              进入 42 家机场品牌高级条件筛选中心 &rarr;
            </a>
          </div>
        </section>

        <!-- 双专题快捷枢纽: 品牌库 & 客户端大全 -->
        <section class="hub-banner">
          <div class="hub-card">
            <div>
              <h3>🏢 42 家机场多维品牌库</h3>
              <p>支持按专线架构、VLESS/Hysteria2 协议、晚高峰 4K 测速及价格梯度即时检索，掌握最全测评参数。</p>
            </div>
            <a href="/airports/" class="hub-btn">进入品牌库筛选 &rarr;</a>
          </div>

          <div class="hub-card">
            <div>
              <h3>🛠️ 全平台代理客户端大全</h3>
              <p>Windows、macOS、iOS（小火箭）、Android 全套客户端下载通道与新手保姆级订阅导入指南。</p>
            </div>
            <a href="/clients/" class="hub-btn">查看客户端教程 &rarr;</a>
          </div>
        </section>

        <!-- 站点更新与统计 -->
        <section class="stats-section">
          <SectionHeader
            number="02"
            title="测评矩阵数据指标"
            intro="全天候自动化网络测速监控，保持客观中立，拒绝无意义推广。"
          />

          <div class="stats-grid">
            <div class="stat-item">
              <span class="stat-value">42 家</span>
              <span class="stat-label">深度测评品牌</span>
            </div>
            <div class="stat-item">
              <span class="stat-value">{formatWordCount(wordCount)}</span>
              <span class="stat-label">实测矩阵字数</span>
            </div>
            <div class="stat-item">
              <span class="stat-value">{tagCount} 个</span>
              <span class="stat-label">协议与分类标签</span>
            </div>
          </div>
        </section>

        <!-- 最近更新评测列表 -->
        <section class="recent-posts-section">
          <SectionHeader
            number="03"
            title="最新测评与技术报告"
            intro="展示最新发布的 10 篇网络节点与协议深度评测文章"
          />

          {recentPosts.length > 0 ? (
            <>
              <div class="home-posts-list">
                {recentPosts.map((post) => (
                  <PostListItem
                    post={post}
                    titleTag="h3"
                    articleClass="home-post-item"
                    titleClass="home-post-title"
                    showExcerpt={false}
                    metaContainerClass="home-post-meta"
                    metaItemClass="home-post-meta-item"
                    metaTagsClass="home-post-tags"
                    tagLinkClass="home-tag-link hover-scale"
                    tagLimit={3}
                  />
                ))}
              </div>
              <a href="/blog" class="blog-link">查看全部 43 篇评测与指南 ⇗</a>
            </>
          ) : (
            <p class="empty-state">暂无文章</p>
          )}
        </section>
      </div>
    </ContentCard>
  </div>
</PageShell>
